<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.form.chatter.recipients</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mail.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@id='emails']" position="after">
                <block title="Chatter Recipients" id="chatter_recipients">
                    <setting
                        string="Default recipient display"
                        help="How chatter recipients are shown by default: a single collapsed 'To' line, or the full To/Cc/Bcc split."
                    >
                        <field name="chatter_recipients_default_display" />
                    </setting>
                    <setting
                        string="Allow toggling recipients"
                        help="Let users switch between the single 'To' line and the full To/Cc/Bcc display."
                    >
                        <field name="chatter_recipients_allow_toggle" />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
