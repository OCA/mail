<?xml version="1.0" encoding="utf-8" ?>
<!--
    License AGPL-3.0 or later (https://www.gnu.org/licenses/agpl.html).

    Demo activities cover every state the reminder report distinguishes:
    overdue, each reminder level, not yet in the reminder timeframe and done.
    Deadlines are relative to the installation date.
-->
<odoo noupdate="1">
    <record id="mail_activity_type_single_reminder" model="mail.activity.type">
        <field name="name">Demo: Single Reminder</field>
        <field name="summary">Reminder 2 days before the deadline</field>
        <field name="reminders">2</field>
        <field name="delay_count">5</field>
    </record>
    <record id="mail_activity_type_two_reminders" model="mail.activity.type">
        <field name="name">Demo: Two Reminders</field>
        <field name="summary">Reminders 3 days before and on the deadline day</field>
        <field name="reminders">0/3</field>
        <field name="delay_count">7</field>
    </record>

    <!-- Single reminder level: 2 days before the deadline -->
    <record id="mail_activity_single_overdue" model="mail.activity">
        <field name="summary">Demo: single reminder, overdue</field>
        <field name="activity_type_id" ref="mail_activity_type_single_reminder" />
        <field name="res_model_id" ref="base.model_res_partner" />
        <field name="res_id" ref="base.res_partner_1" />
        <field name="user_id" ref="base.user_demo" />
        <field name="date_deadline" eval="DateTime.today() - relativedelta(days=1)" />
    </record>
    <record id="mail_activity_single_reminder_1" model="mail.activity">
        <field name="summary">Demo: single reminder, level 1</field>
        <field name="activity_type_id" ref="mail_activity_type_single_reminder" />
        <field name="res_model_id" ref="base.model_res_partner" />
        <field name="res_id" ref="base.res_partner_2" />
        <field name="user_id" ref="base.user_demo" />
        <field name="date_deadline" eval="DateTime.today() + relativedelta(days=1)" />
    </record>
    <record id="mail_activity_single_planned" model="mail.activity">
        <field name="summary">Demo: single reminder, not in reminder timeframe</field>
        <field name="activity_type_id" ref="mail_activity_type_single_reminder" />
        <field name="res_model_id" ref="base.model_res_partner" />
        <field name="res_id" ref="base.res_partner_3" />
        <field name="user_id" ref="base.user_demo" />
        <field name="date_deadline" eval="DateTime.today() + relativedelta(days=6)" />
    </record>
    <record id="mail_activity_single_done" model="mail.activity">
        <field name="summary">Demo: single reminder, done</field>
        <field name="activity_type_id" ref="mail_activity_type_single_reminder" />
        <field name="res_model_id" ref="base.model_res_partner" />
        <field name="res_id" ref="base.res_partner_4" />
        <field name="user_id" ref="base.user_demo" />
        <field name="date_deadline" eval="DateTime.today() - relativedelta(days=2)" />
        <field name="active" eval="False" />
    </record>

    <!-- Two reminder levels: 3 days before (level 1) and on the deadline day (level 2) -->
    <record id="mail_activity_two_overdue" model="mail.activity">
        <field name="summary">Demo: two reminders, overdue</field>
        <field name="activity_type_id" ref="mail_activity_type_two_reminders" />
        <field name="res_model_id" ref="base.model_res_partner" />
        <field name="res_id" ref="base.res_partner_1" />
        <field name="user_id" ref="base.user_demo" />
        <field name="date_deadline" eval="DateTime.today() - relativedelta(days=4)" />
    </record>
    <record id="mail_activity_two_reminder_2" model="mail.activity">
        <field name="summary">Demo: two reminders, level 2</field>
        <field name="activity_type_id" ref="mail_activity_type_two_reminders" />
        <field name="res_model_id" ref="base.model_res_partner" />
        <field name="res_id" ref="base.res_partner_2" />
        <field name="user_id" ref="base.user_demo" />
        <field name="date_deadline" eval="DateTime.today()" />
    </record>
    <record id="mail_activity_two_reminder_1" model="mail.activity">
        <field name="summary">Demo: two reminders, level 1</field>
        <field name="activity_type_id" ref="mail_activity_type_two_reminders" />
        <field name="res_model_id" ref="base.model_res_partner" />
        <field name="res_id" ref="base.res_partner_3" />
        <field name="user_id" ref="base.user_demo" />
        <field name="date_deadline" eval="DateTime.today() + relativedelta(days=2)" />
    </record>
    <record id="mail_activity_two_planned" model="mail.activity">
        <field name="summary">Demo: two reminders, not in reminder timeframe</field>
        <field name="activity_type_id" ref="mail_activity_type_two_reminders" />
        <field name="res_model_id" ref="base.model_res_partner" />
        <field name="res_id" ref="base.res_partner_4" />
        <field name="user_id" ref="base.user_demo" />
        <field name="date_deadline" eval="DateTime.today() + relativedelta(days=10)" />
    </record>
    <record id="mail_activity_two_done" model="mail.activity">
        <field name="summary">Demo: two reminders, done</field>
        <field name="activity_type_id" ref="mail_activity_type_two_reminders" />
        <field name="res_model_id" ref="base.model_res_partner" />
        <field name="res_id" ref="base.res_partner_10" />
        <field name="user_id" ref="base.user_demo" />
        <field name="date_deadline" eval="DateTime.today() - relativedelta(days=3)" />
        <field name="active" eval="False" />
    </record>

    <!-- A second user, so the reminder report produces one mail per user -->
    <record id="mail_activity_admin_two_reminder_1" model="mail.activity">
        <field name="summary">Demo: two reminders, level 1 (admin)</field>
        <field name="activity_type_id" ref="mail_activity_type_two_reminders" />
        <field name="res_model_id" ref="base.model_res_partner" />
        <field name="res_id" ref="base.res_partner_12" />
        <field name="user_id" ref="base.user_admin" />
        <field name="date_deadline" eval="DateTime.today() + relativedelta(days=3)" />
    </record>
</odoo>
