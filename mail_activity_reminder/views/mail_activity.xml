<odoo>
    <record
        id="mail_activity_reminder_mail_activity_view_search_inherit"
        model="ir.ui.view"
    >
        <field
            name="name"
        >mail_activity_reminder.mail.activity.view.search.inherit</field>
        <field name="model">mail.activity</field>
        <field name="inherit_id" ref="mail.mail_activity_view_search" />
        <field name="arch" type="xml">
            <filter name="filter_archived" position="before">
                <filter
                    name="filter_to_remind"
                    string="To Remind"
                    domain="[('to_remind', '=', True)]"
                    help="Activities that are not overdue but within the reminder timeframe of their activity type"
                />
            </filter>
        </field>
    </record>
</odoo>
