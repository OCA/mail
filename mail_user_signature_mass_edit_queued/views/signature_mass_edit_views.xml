<odoo>
    <record id="view_signature_mass_edit_form" model="ir.ui.view">
        <field name="model">signature.mass.edit</field>
        <field
            name="inherit_id"
            ref="mail_user_signature_mass_edit.view_signature_mass_edit_form"
        />
        <field name="arch" type="xml">
            <field name="group_ids" position="after">
                <field name="run_in_queue_job" readonly="state != 'draft'" />
            </field>
        </field>
    </record>

    <record id="view_signature_mass_edit_search" model="ir.ui.view">
        <field name="model">signature.mass.edit</field>
        <field
            name="inherit_id"
            ref="mail_user_signature_mass_edit.view_signature_mass_edit_search"
        />
        <field name="arch" type="xml">
            <filter name="filter_done" position="before">
                <filter
                    string="In Progress"
                    name="filter_in_progress"
                    domain="[('state', '=', 'in_progress')]"
                />
            </filter>
        </field>
    </record>
</odoo>
