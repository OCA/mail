<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_mail_drop_target" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.mail</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mail.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='emails']" position="inside">
                <setting id="restrict_template_rendering_setting" string="Disable Mail Drag&amp;Drop Notification" help="When a user drops an email into an existing thread the followers of the thread will not be notified.">
                    <field name="disable_notify_mail_drop_target"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>