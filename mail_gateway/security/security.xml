<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="module_category_gateway" model="ir.module.category">
        <field name="name">Gateway</field>
    </record>
    <record id="gateway_privilege" model="res.groups.privilege">
        <field name="name">Gateway</field>
        <field name="category_id" ref="module_category_gateway" />
    </record>
    <record id="gateway_user" model="res.groups">
        <field name="name">User</field>
        <field
            name="user_ids"
            eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
        />
        <field name="privilege_id" ref="gateway_privilege" />
    </record>
</odoo>
