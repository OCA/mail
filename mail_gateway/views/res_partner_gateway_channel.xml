<odoo>
    <record id="view_res_partner_gateway_channel_form" model="ir.ui.view">
        <field name="name">Partner Gateway Channel Form</field>
        <field name="model">res.partner.gateway.channel</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="partner_id" />
                        <field name="gateway_id" />
                        <field name="gateway_token" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_res_partner_gateway_channel_tree" model="ir.ui.view">
        <field name="name">Partner Gateway Channel Tree</field>
        <field name="model">res.partner.gateway.channel</field>
        <field name="arch" type="xml">
            <list>
                <field name="partner_id" />
                <field name="gateway_id" />
                <field name="gateway_token" />
            </list>
        </field>
    </record>

    <record id="view_res_partner_gateway_channel_search" model="ir.ui.view">
        <field name="name">Partner Gateway Channel Tree</field>
        <field name="model">res.partner.gateway.channel</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id" />
                <field name="gateway_id" />
                <field name="gateway_token" />
            </search>
        </field>
    </record>

    <record id="res_partner_gateway_channel_act_window" model="ir.actions.act_window">
        <field name="name">Gateway Partner Channels</field>
        <field name="res_model">res.partner.gateway.channel</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>
    <record id="res_partner_gateway_channel_menu" model="ir.ui.menu">
        <field name="name">Gateway Partner Channels</field>
        <field name="parent_id" ref="base.menu_email" />
        <field name="action" ref="res_partner_gateway_channel_act_window" />
        <field name="sequence" eval="16" />
    </record>
</odoo>
