#. module: mail_template_queue_job
#: model:ir.model,name:mail_template_queue_job.model_mail_template
msgid "Email Templates"
msgstr "Plantillas de correo electrónico"

#. module: mail_template_queue_job
#: model:ir.model,name:mail_template_queue_job.model_mail_thread
msgid "Email Thread"
msgstr "Hilo de correo electrónico"

#. module: mail_template_queue_job
#: model:ir.model.fields,help:mail_template_queue_job.field_mail_template__post_in_queue_job
msgid ""
"Messages posted automatically with this template (for example, an order or "
"delivery confirmation) are rendered and sent in a queue job, so the user "
"does not wait for them."
msgstr ""
"Los mensajes publicados automáticamente con esta plantilla (por ejemplo, la "
"confirmación de un pedido o de una entrega) se generan y envían en un "
"trabajo en cola, para que el usuario no tenga que esperar."

#. module: mail_template_queue_job
#. odoo-python
#: code:addons/mail_template_queue_job/models/mail_thread.py:0
msgid "Nothing to post: the record or the template is gone."
msgstr "Nada que publicar: el registro o la plantilla ya no existen."

#. module: mail_template_queue_job
#. odoo-python
#: code:addons/mail_template_queue_job/models/mail_thread.py:0
msgid "Post %(template)s on %(record)s"
msgstr "Publicar %(template)s en %(record)s"

#. module: mail_template_queue_job
#: model:ir.model.fields,field_description:mail_template_queue_job.field_mail_template__post_in_queue_job
msgid "Post in a Queue Job"
msgstr "Publicar en un trabajo en cola"
