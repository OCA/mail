<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t
        t-name="mail_activity_team.ActivityMenu"
        t-inherit="mail.ActivityMenu"
        t-inherit-mode="extension"
    >
        <xpath expr="//div[hasclass('o-mail-ActivityMenu-empty')]" position="before">
            <div class="o_mail_activity_team_filters o_mail_systray_dropdown_top">
                <ul class="nav nav-pills">
                    <li class="nav-item cursor-pointer">
                        <a
                            class="o_filter_nav_item nav-link"
                            t-att-class="{active: this.teamState.filter === 'my'}"
                            t-on-click="() => this.onClickActivityFilter('my')"
                        >
                            My Activities
                        </a>
                    </li>
                    <li class="nav-item cursor-pointer">
                        <a
                            class="o_filter_nav_item nav-link"
                            t-att-class="{active: this.teamState.filter === 'team'}"
                            t-on-click="() => this.onClickActivityFilter('team')"
                        >
                            Team Activities
                        </a>
                    </li>
                </ul>
            </div>
        </xpath>
    </t>
</templates>
