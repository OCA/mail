<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="mail_recipient_tracking.FailedMessageReview">
        <button
            class="o_mail_tracking_set_reviewed btn btn-link btn-success text-muted p-0 me-3"
            t-on-click="this.onClickSetReviewed"
        >
            <i class="oi" data-icon="check" role="img" aria-label="Set As Reviewed" />
            Set as Reviewed
        </button>
        <button
            t-if="this.message().can_retry_failed_mails"
            class="o_mail_tracking_retry btn btn-link btn-success text-muted p-0 me-3"
            t-on-click="this.onClickRetry"
        >
            <i class="oi" data-icon="send" role="img" aria-label="Retry" />
            Retry
        </button>
    </t>
</templates>
