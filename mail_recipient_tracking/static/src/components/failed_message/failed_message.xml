<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="mail_recipient_tracking.FailedMessage">
        <t t-set="message" t-value="this.message()" />
        <div class="o_mail_tracking_failed_message o-mail-Activity d-flex py-1 mb-2">
            <div
                class="o-mail-Activity-sidebar d-flex flex-shrink-0 position-relative align-items-start justify-content-center"
            >
                <div
                    class="o-mail-Activity-avatarContainer position-relative d-flex align-items-center justify-content-center"
                    t-att-role="this.hasAuthorClickable ? 'button' : 'img'"
                    t-on-click.stop.prevent="this.onClickAvatar"
                >
                    <img
                        class="o-mail-Activity-avatar o_avatar rounded"
                        t-att-src="message.authorAvatarUrl"
                    />
                    <div
                        class="o-mail-Activity-iconContainer rounded-circle d-flex align-items-center justify-content-center position-absolute top-100 start-100 translate-middle mt-n1 ms-n1 w-50 h-50 text-bg-danger"
                    >
                        <i class="oi oi-sm oi-filled" data-icon="warning" role="img" />
                    </div>
                </div>
            </div>
            <div class="flex-grow px-1">
                <div class="o-mail-Activity-info lh-1">
                    <strong class="me-1 text-truncate" t-out="message.authorName" />
                    <small
                        class="o-mail-Message-date text-muted opacity-75"
                        t-att-title="message.datetimeMedium"
                    >
                        - <RelativeTime datetime="message.datetime" />
                    </small>
                    <i
                        class="oi oi-filled p-0 text-muted ms-1 cursor-pointer"
                        data-icon="info"
                        role="button"
                        title="Info"
                        aria-label="Info"
                        t-on-click="this.toggleDetails"
                    />
                </div>
                <div class="lh-lg">
                    <FailedMessageReview message="message" />
                    <button
                        class="o_mail_tracking_jump btn btn-link btn-success text-muted p-0 me-3"
                        t-on-click="this.onClickJump"
                    >
                        <i
                        class="oi"
                        data-icon="keyboard_double_arrow_down"
                        role="img"
                        aria-label="Go"
                    />
                        Go to message
                    </button>
                </div>
                <div class="o-mail-Activity-info lh-1">
                    <strong class="text-danger">Failed Recipients: </strong>
                    <MessageTracking
                        partner_trackings="this.failedRecipients"
                        skip_track_links="true"
                    />
                </div>
                <div
                    t-if="this.state.showDetails"
                    class="position-relative text-break o-mail-Message-body p-1"
                >
                    <em t-if="message.subject" class="mb-1 me-2">Subject: <t
                        t-out="message.subject"
                    /></em>
                    <t t-if="message.body" t-out="message.body" />
                </div>
            </div>
        </div>
    </t>
</templates>
