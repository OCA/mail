<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="mail_recipient_tracking.TrackingStatus">
        <span t-if="tracking.isCc" class="mail_tracking_cc">
            <i class="oi" data-icon="closed_caption" role="img" aria-label="Cc" />
        </span>
        <!-- Cc recipients with their own email also show their status -->
        <t t-if="!tracking.isCc or tracking.status !== 'unknown'">
            <span t-if="!tracking.partner_id" class="mail_anon_recipient">
                <i
                    class="oi"
                    data-icon="visibility_off"
                    role="img"
                    aria-label="Anonymous Recipient"
                />
            </span>
            <span t-elif="tracking.status === 'unknown'" class="mail_tracking_unknown">
                <i
                    class="oi"
                    data-icon="block"
                    role="img"
                    aria-label="Unknown Status"
                />
            </span>
            <span t-elif="tracking.status === 'waiting'" class="mail_tracking_waiting">
                <i
                    class="oi"
                    data-icon="schedule"
                    role="img"
                    aria-label="Waiting Status"
                />
            </span>
            <span
                t-elif="tracking.status === 'error'"
                class="mail_tracking_error text-danger"
            >
                <i
                    t-if="tracking.error_type === 'no_recipient'"
                    class="oi"
                    data-icon="person_remove"
                    role="img"
                    aria-label="Error Status"
                />
                <i
                    t-else=""
                    class="oi"
                    data-icon="close"
                    role="img"
                    aria-label="Error Status"
                />
            </span>
            <span t-elif="tracking.status === 'sent'" class="mail_tracking_sent">
                <i class="oi" data-icon="check" role="img" aria-label="Sent Status" />
            </span>
            <span
                t-elif="tracking.status === 'delivered'"
                class="mail_tracking_double_check mail_tracking_delivered"
                role="img"
                aria-label="Delivered Status"
            >
                <i class="oi" data-icon="check" />
                <i class="oi" data-icon="check" />
            </span>
            <span
                t-elif="tracking.status === 'opened'"
                class="mail_tracking_double_check mail_tracking_opened text-success"
                role="img"
                aria-label="Opened Status"
            >
                <i class="oi" data-icon="check" />
                <i class="oi" data-icon="check" />
            </span>
        </t>
    </t>
</templates>
