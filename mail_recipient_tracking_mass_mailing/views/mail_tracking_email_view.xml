<odoo>
    <record id="view_mail_tracking_email_form" model="ir.ui.view">
        <field name="name">Add mass mailing and mail stadistics</field>
        <field name="model">mail.tracking.email</field>
        <field
            name="inherit_id"
            ref="mail_recipient_tracking.view_mail_tracking_email_form"
        />
        <field name="arch" type="xml">
            <field name="date" position="after">
                <field name="mass_mailing_id" />
                <field name="mail_stats_id" />
            </field>
        </field>
    </record>
</odoo>
