<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_email_server_form" model="ir.ui.view">
        <field name="name">fetchmail.server.form.incoming.test</field>
        <field name="model">fetchmail.server</field>
        <field name="inherit_id" ref="mail.view_email_server_form" />
        <field name="arch" type="xml">
            <xpath expr="//button[@name='fetch_mail']" position="after">
                <button
                    name="%(action_fetchmail_incoming_test)d"
                    type="action"
                    string="Simulate Incoming Email"
                />
            </xpath>
        </field>
    </record>
</odoo>
