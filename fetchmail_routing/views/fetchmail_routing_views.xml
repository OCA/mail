<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_fetchmail_routing_form" model="ir.ui.view">
        <field name="model">fetchmail.routing</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="active" widget="boolean_toggle" />
                        <field name="model_id" options="{'no_create_edit': True}" />
                        <field
                            name="server_ids"
                            widget="many2many_tags"
                            options="{'no_create_edit': True}"
                        />
                    </group>

                    <notebook>
                        <page name="code" string="Code">
                            <field
                                name="code"
                                widget="ace"
                                options="{'mode': 'python'}"
                            />
                        </page>
                        <page string="Help" name="help_info">
                            <group>
                                <div style="margin-top: 4px;">
                                    <h3>Help with Python expressions</h3>
                                    <p>The following variables are defined:</p>
                                    <field name="help_text" />
                                </div>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_fetchmail_routing_list" model="ir.ui.view">
        <field name="model">fetchmail.routing</field>
        <field name="arch" type="xml">
            <list decoration-muted="not active">
                <field name="active" invisible="1" />
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="model_id" />
                <field name="server_ids" widget="many2many_tags" />
            </list>
        </field>
    </record>

    <record id="action_fetchmail_routing" model="ir.actions.act_window">
        <field name="name">Incoming Routing</field>
        <field name="res_model">fetchmail.routing</field>
        <field name="context">{"active_test": False}</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        parent="base.menu_email"
        id="menu_fetchmail_routing"
        action="action_fetchmail_routing"
        name="Incoming Routing"
        sequence="7"
        groups="base.group_no_one"
    />
</odoo>
