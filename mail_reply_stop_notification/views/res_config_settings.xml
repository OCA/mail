<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field
            name="name"
        >res.config.settings.view.form.inherit.mail.reply.stop.notification</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mail.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@id='emails']" position="inside">
                <setting
                    id="mail_reply_stop_notification_setting"
                    help="Skip Email notification to followers on a reply"
                >
                    <field name="mail_reply_stop_notification" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
